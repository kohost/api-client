{
  "extends": "./tsconfig.json",
  "include": [".generated/**/*"],
  // Standalone validator code is machine-generated; its sibling .d.ts types it.
  "exclude": ["dist", "node_modules", ".generated/validators/*.js"],
  "compilerOptions": {
    "skipLibCheck": true,
    "checkJs": false,
    "noEmit": true,
    "rootDir": ".generated",
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/typescript/api-client-check.tsbuildinfo"
  }
}
